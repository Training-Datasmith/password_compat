{
    "name": "ircmaxell/password-compat",
    "description": "A compatibility library for the proposed simplified password hashing algorithm: https://wiki.php.net/rfc/password_hash",
    "keywords": ["password", "hashing"],
    "homepage": "https://github.com/ircmaxell/password_compat",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Ferrara",
            "email": "ircmaxell@php.net",
            "homepage": "http://blog.ircmaxell.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^8.5.52"
    },
    "autoload": {
        "files": ["lib/password.php"]
    },
    "scripts": {
        "check-pins": "php scripts/check-cluster-pins.php",
        "check-rename": "php scripts/check-rename.php",
        "test": [
            "@check-pins",
            "@check-rename",
            "php -d error_reporting=32767 vendor/bin/phpunit --colors=never --no-coverage"
        ]
    }
}
